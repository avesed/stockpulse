# StockPulse Configuration

# Database
DATABASE_URL=postgresql+asyncpg://stockpulse:stockpulse@localhost:5433/stockpulse
POSTGRES_PASSWORD=stockpulse

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT (generate: python -c "import secrets; print(secrets.token_hex(32))")
# Leave empty to auto-generate and persist in DB
JWT_SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin bootstrap (first user with this email gets admin role)
FIRST_ADMIN_EMAIL=

# External API Keys (optional — can also be set via admin UI)
FINNHUB_API_KEY=
TUSHARE_TOKEN=
TIINGO_API_KEY=
TAVILY_API_KEY=
POLYGON_API_KEY=

# Playwright (optional content extraction fallback)
PLAYWRIGHT_SERVICE_URL=http://playwright-service:8002

# Server
LOG_LEVEL=info
DEBUG=false
